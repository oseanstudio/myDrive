<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MyDrive</RootNamespace>
    <Version>0.4.17</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\myDrive.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\._*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Page Remove="**\._*" />
    <Compile Remove="**\._*" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <Content Include="Assets\myDrive.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\myDrive.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\tray-white.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\tray-dark.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\docs\BLIP.md" Link="Blip\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyWinUIResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WinUIResource Include="$(TargetDir)$(TargetName).pri" />
      <WinUIResource Include="$(TargetDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(WinUIResource)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
